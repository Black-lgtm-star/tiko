{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/work(?:/.*)?$",
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/api/stocks$",
      "methods": ["POST", "PUT", "PATCH", "DELETE", "OPTIONS", "TRACE", "CONNECT"],
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/api/stocks$",
      "missing": [{ "type": "query", "key": "q" }],
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/api/stocks$",
      "has": [{ "type": "query", "key": "q", "value": { "re": "^.{81,}$" } }],
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/(?:request|buy|purchase/success|admin(?:/review|/password)?)/?$",
      "methods": ["PUT", "PATCH", "DELETE", "OPTIONS", "TRACE", "CONNECT"],
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/api/(?:checkout|stripe-webhook)$",
      "methods": ["GET", "PUT", "PATCH", "DELETE", "OPTIONS", "TRACE", "CONNECT", "HEAD"],
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/(?:\\.env|\\.git|\\.vercel)(?:/.*)?$",
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/(?:wp-admin(?:/.*)?|wp-login\\.php|xmlrpc\\.php|phpmyadmin(?:/.*)?)$",
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/api/stocks$",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "(?i).*(?:curl|wget|sqlmap|nikto|scrapy|python-requests).*" } }],
      "mitigate": { "action": "challenge" }
    },
    {
      "src": "^/api/crypto$",
      "methods": ["POST", "PUT", "PATCH", "DELETE", "OPTIONS", "TRACE", "CONNECT"],
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/api/crypto$",
      "missing": [{ "type": "query", "key": "kind" }],
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/api/quote$",
      "methods": ["POST", "PUT", "PATCH", "DELETE", "OPTIONS", "TRACE", "CONNECT"],
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/api/quote$",
      "missing": [{ "type": "query", "key": "symbol" }, { "type": "query", "key": "symbols" }],
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/api/quote$",
      "has": [
        { "type": "query", "key": "symbol", "value": { "re": "^.{33,}$" } }
      ],
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/api/quote$",
      "has": [
        { "type": "query", "key": "symbols", "value": { "re": "^.{201,}$" } }
      ],
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/api/quote$",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "(?i).*(?:curl|wget|sqlmap|nikto|scrapy|python-requests).*" } }],
      "mitigate": { "action": "challenge" }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "X-DNS-Prefetch-Control", "value": "off" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), display-capture=(self), picture-in-picture=(self), interest-cohort=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; child-src 'none'; worker-src 'none'; media-src 'self' blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://www.alphavantage.co https://api.frankfurter.dev wss://ws.derivws.com https://api.derivws.com wss://api.derivws.com; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
